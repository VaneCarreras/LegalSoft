@{
    ViewData["Title"] = "Expedientes";
}
@* ///MODIFICAR TODO LOS EXP SERAN CON LISTA TB// *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link href="~/Fotorama/fotorama.4.6.4.css" rel="stylesheet" />

<body class="body2 fondoLogo">
<div class="text-center m-4">
  <img src="~/img/ExpedientesImg.png" alt="" class="juntos imgIcono">
    <h1 class="titulos juntos">MIS EXPEDIENTES</h1>
</div>
        <hr class="hrTitulos m-4">

<div class="row">
<div class="mb-3 col-3">
  <label for="DniEquipoBuscar" class="form-label">Nombre Equipo</label>
  <input type="text" id="DniEquipoBuscar" class="form-control"/>
</div>
<div class="mb-3 col-3">
  <button style="margin-top: 32px;" type="button" class="btn btn-secondary" onclick="BuscarExpediente()">
    Buscar
  </button>
</div>
@* <div class="mb-3 col-1"></div> *@
<div class="mb-3 col-3">
  <label for="CaratulaBuscar" class="form-label">Carátula</label>
  <input type="text" id="CaratulaBuscar" class="form-control"/>
</div>
<div class="mb-3 col-3">
  <button style="margin-top: 32px;" type="button" class="btn btn-secondary" onclick="BuscarExpediente()">
    Buscar
  </button>
</div>
</div>
<div class="row">
<!-- Button trigger modal -->
<div class="mb-2 col-10">
  <button type="button" class="btn btn-secondary" onclick="NuevoRegistro()" data-bs-toggle="modal" data-bs-target="#ModalExpedientes">
    Nuevo Expediente
  </button>
</div>

<div class="form-check mb-2 col-2">
  <input class="form-check-input" type="checkbox" id="chkSoloHabilitados" checked>
  <label class="form-check-label" for="chkSoloHabilitados">
    Mostrar solo habilitados
  </label>
</div>
</div>
<table class="table table-dark table-borderedless table-striped table-condensed">
  <thead>
    <tr>
      @* <th class="ocultar-en-550px">Nro</th> *@
      <th>Carátula</th>
      <th>Cliente</th>
      <th class="ocultar-en-768px">Abogado</th>
      <th class="ocultar-en-768px">Inicio</th>
      @* <th >Último Decreto</th> *@
      @* <th class="ocultar-en-768px">Docs</th> *@
      <th class="ocultar-en-550px">Link</th>
      <th>Área</th>
      <th>Dependencia</th>
      <th>Ubicación</th>

      <th style="width: 70px"></th>
      <th style="width: 70px"></th>
            <th style="width: 70px"></th>

    </tr>
  </thead>
  <tbody  id="tbody-expedientes">
  </tbody>
</table>

<div id="pagination-expedientes"></div>



<!-- Modal -->
<div class="modal fade" id="ModalExpedientes" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-secondary">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="ModalTitulo">Nuevo Expediente</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form>
          <div class="row">
            <input type="hidden" id="ExpedienteID" value="0" />

            @* <div class="mb-3 col-6">
             <label for="Numero" class="form-label">Nro</label>
             <input type="text" class="form-control" id="Numero" style="text-transform:uppercase" placeholder="Nro de expediente">
            </div> *@

            <div class="mb-3 col-6">
             <label for="Caratula" class="form-label">Caratula</label>
             <input type="text" class="form-control" id="Caratula" style="text-transform:uppercase" placeholder="Caratula de expediente">
            </div>
<div class="mb-3 col-6">
              <label for="FechaInicio" class="form-label">Fecha de Inicio</label>
              <input type="date" id="FechaInicio" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3 col-6 ">
              <label for="NombreCompletoCliente" class="form-label">Cliente</label>
              @Html.DropDownList("ClienteID", null, htmlAttributes: new { @class = "form-control form-select"})
            </div>

            <div class=" mb-3 col-6">
              <label for="NombreCompletoEquipo" class="form-label">Abogado</label>
              @Html.DropDownList("EquipoID", null, htmlAttributes: new { @class = "form-control form-select"})
            </div>

            

            @* <div class="mb-3 col-6">
              <label for="FechaFin" class="form-label">Fecha de Fin</label>
              <input type="date" id="FechaFin" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div> *@

            

            @* <div class="mb-3 col-6">
             <label for="DocLegales" class="form-label">Documentos</label>
             <input type="text" class="form-control" id="DocLegales" style="text-transform:uppercase" placeholder="Documentos del expediente">
            </div> *@

            <div class="mb-3 col-6">
             <label for="LinkContenido" class="form-label">Link al Contenido</label>
             <input type="text" class="form-control" id="LinkContenido"  placeholder="COPIAR LINK SAC">
            </div>

            @* <div class="mb-3 col-6">
              <label for="EstadoExpediente" class="form-label">Estado</label>
              @Html.DropDownList("EstadoExpediente", null, htmlAttributes: new { @class = "form-control" })
            </div> *@
            <div class="mb-3 col-6">
                <label for="Area" class="form-label">Área</label>
                <select id="Area" name="Area" class="form-select form-control">
                  <option value="" disabled selected>SELECCIONAR</option>

                  @foreach (var area in Enum.GetValues(typeof(Area)))
                  {

                    <option value="@((int)area)">@area</option>
                  }
                </select>
            </div>

            <div class="mb-3 col-6">
                <label for="Dependencia" class="form-label">Dependencia</label>
                <select id="Dependencia" name="Dependencia" class="form-select form-control">
                  <option value="" disabled selected>SELECCIONAR</option>

                  @foreach (var dependencia in Enum.GetValues(typeof(Dependencia)))
                  {

                    <option value="@((int)dependencia)">@dependencia</option>
                  }
                </select>
            </div>

            <div class="mb-3 col-6">
                <label for="Ubicacion" class="form-label">Ubicación</label>
                <select id="Ubicacion" name="Ubicacion" class="form-select form-control">
                  <option value="" disabled selected>SELECCIONAR</option>

                  @foreach (var ubicacion in Enum.GetValues(typeof(Ubicacion)))
                  {

                    <option value="@((int)ubicacion)">@ubicacion</option>
                  }
                </select>
              </div>
            <div class="mb-3 col-12">
  <label for="UltimoDecreto" class="form-label">Ultimo Decreto</label>
  <textarea class="form-control" id="UltimoDecreto" style=" height: 180px;" placeholder="ULTIMO DECRETO"></textarea>
</div>

          </div>
        </form>      
      </div>
      <div class="modal-footer">
        <button type="button" onclick="LimpiarModal()" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" onclick="GuardarRegistro()" class="btn btn-warning">Guardar</button>
                  <button type="button" class="btn btn-success" onclick="ImprimirExpediente()">IMPRIMIR</button>

      </div>
    </div>
  </div>
</div>


<div id="ModalDocsExpediente" class="modal fade" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="docsExpedienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Documentos Legales del Expediente</h5>
                <button type="button" onclick="CerrarModalDocsExpediente();" class="cruzCerrar" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <input type="hidden" id="ExpedienteID" value="0" />

            <div class="modal-body">
                <div class="nav nav-tabs" id="tabsDocs" role="tablist">
                    <a class="nav-link active" id="tab_docs_ver-tab" data-bs-toggle="tab" href="#tab_docs_ver" role="tab" aria-selected="true">Visualizar</a>
                    <a class="nav-link" id="tab_docs_agregar-tab" data-bs-toggle="tab" href="#tab_docs_agregar" role="tab" aria-selected="false">Agregar</a>
                    <a class="nav-link" id="tab_docs_eliminar-tab" data-bs-toggle="tab" href="#tab_docs_eliminar" role="tab" aria-selected="false">Eliminar</a>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab_docs_ver" role="tabpanel">
                        <div id="DocsExpediente"></div>
                    </div>
                    <div class="tab-pane fade" id="tab_docs_agregar" role="tabpanel">
                        <div style="margin-top:15px;">
                            <input type="file" id="inputDoc" accept=".pdf,.doc,.docx" />
                        </div>
                        <div style="margin-top:15px; text-align:center;">
                            <button onclick="GuardarDocumento();" class="btn btn-ovalo">Guardar Documento</button>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab_docs_eliminar" role="tabpanel">
                        <table id="DocsExpedienteEliminar" class="table table-bordered"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/fotorama.js"></script>


        <script>
        $(document).ready(function () {
            // Carga inicial
            ListadoExpedientes(1);

            // Cuando se cambia el checkbox
            document.getElementById("chkSoloHabilitados").addEventListener("change", function () {
                ListadoExpedientes(1);
            });
        });
    </script>

<script>
window.onload = ListadoExpedientes();



$(document).ready(function () {
    $('#DniEquipoBuscar').on('input', function () {
        const nombre = $(this).val().trim();
        if (nombre.length > 0) {
            $('#CaratulaBuscar')
                .prop('disabled', true)
                .val('') // Limpiar el campo DNI
                .attr('placeholder', 'Borrar nombre para habilitar');
        } else {
            $('#CaratulaBuscar')
                .prop('disabled', false)
                .attr('placeholder', 'Caratula...');
        }
    });

    $('#CaratulaBuscar').on('input', function () {
        const dni = $(this).val().trim();
        if (dni.length > 0) {
            $('#DniEquipoBuscar')
                .prop('disabled', true)
                .val('') // Limpiar el campo nombre
                .attr('placeholder', 'Borrar caratula para habilitar');
        } else {
            $('#DniEquipoBuscar')
                .prop('disabled', false)
                .attr('placeholder', 'Nombre...');
        }
    });
});


function ListadoExpedientes(pagina = 1){
     const pageSize = 7; // cantidad de clientes por página
        const soloHabilitados = document.getElementById("chkSoloHabilitados").checked;

    $.ajax({
        // la URL para la petición
        url: '../../Expedientes/ListadoExpedientes',
        // la información a enviar
        // (también es posible utilizar una cadena de datos)
        data: { 
            pagina: pagina,
            tamanioPagina: pageSize,
            soloHabilitados: soloHabilitados
        },
        // especifica si será una petición POST o GET
        type: 'POST',
        // el tipo de información que se espera de respuesta
        dataType: 'json',
        // código a ejecutar si la petición es satisfactoria;
        // la respuesta es pasada como argumento a la función
        success: function (response) {

            const vistaExpediente = response.expedientes;
            const totalPaginas = response.totalPaginas;

            $("#ModalExpedientes").modal("hide");
            LimpiarModal();
            let contenidoTabla = ``;

            $.each(vistaExpediente, function (index, expediente) { 
                const icono = expediente.habilitado 
        ? '<i class="fa-solid fa-user-slash" style="color: #820d19;"></i>' 
        : '<i class="fa-solid fa-user-check" style="color: #0a7c2c;"></i>';
    const tituloBoton = expediente.habilitado ? 'Deshabilitar' : 'Habilitar';
const claseFila = expediente.habilitado ? '' : 'fila-deshabilitada'; 
                
                contenidoTabla += `
                <tr>
                       
                <td  class="${claseFila}" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${expediente.caratula}">
  ${expediente.caratula}
</td>

                
                <td class="${claseFila}">${expediente.nombreCompletoCliente}</td>
                        <td class="${claseFila}">${expediente.nombreCompletoEquipo}</td>
                        


                        <td class="${claseFila}">${expediente.fechaInicio}</td>

                            <td class="${claseFila}"><a href='  ${expediente.linkContenido}  ' target='_blank' style='text-decoration: underline; color: orange;'> ${expediente.linkContenido} </a></td>

                                                <td class="${claseFila}">${expediente.areaString}</td>
                        <td class="${claseFila}">${expediente.dependenciaString}</td>
                        <td class="${claseFila}">${expediente.ubicacionString}</td>


<td class="text-center">
    <button type="button"
            onclick="AbrirModalDocsExpediente(${expediente.expedienteID})"
            data-bs-toggle="modal"
            data-bs-target="#ModalDocsExpediente"
            title="Mostrar Documentos">
<i class="fa-regular fa-folder-open" style="color: #63E6BE;"></i>   </button>
</td>





                    <td class="text-center"><button type="button" onclick="AbrirModalEditar(${expediente.expedienteID})" title="Editar"><i class="fa-duotone fa-solid fa-angles-right" style="--fa-primary-color: #4969a2; --fa-secondary-color: #4969a2;"></i></button></td>
<td class="text-center"><button type="button" onclick="DeshabilitarHabilitarExpediente(${expediente.expedienteID}, ${expediente.habilitado})" title="${tituloBoton}">${icono}</button></td>

                </tr>
             `;

            });

            document.getElementById("tbody-expedientes").innerHTML = contenidoTabla;

            // Si es la primera carga, configurar paginación
            if (!$('#pagination-expedientes').data("twbs-pagination")) {
                $('#pagination-expedientes').twbsPagination({
                    totalPages: totalPaginas,
                    visiblePages: 5,
                    onPageClick: function (event, page) {
                        ListadoExpedientes(page);
                    },
                    first: 'Primera',
                    prev: '<span aria-hidden="true">&laquo;</span>',
                    next: '<span aria-hidden="true">&raquo;</span>',
                    last: 'Última'
                });
            }

        },

        // código a ejecutar si la petición falla;
        // son pasados como argumentos a la función
        // el objeto de la petición en crudo y código de estatus de la petición
        error: function (xhr, status) {
            console.log('Disculpe, existió un problema al cargar el listado');
        }
    });
}

function LimpiarModal(){
    document.getElementById("ClienteID").value = 0;
    document.getElementById("ExpedienteID").value = 0;
    document.getElementById("EquipoID").value = 0;
    // document.getElementById("PersonaID").value = 0; 
    // document.getElementById("NombreCompletoCliente").value = ""; 
    // document.getElementById("NombreCompletoEquipo").value = ""; 
    // document.getElementById("Numero").value = ""; 
        document.getElementById("Caratula").value = ""; 
    document.getElementById("UltimoDecreto").value = ""; 

    document.getElementById("FechaInicio").value = ""; 
    document.getElementById("LinkContenido").value = ""; 

                document.getElementById("Area").value = "";
        document.getElementById("Dependencia").value = "";
        document.getElementById("Ubicacion").value = "";




}

function NuevoRegistro(){
    $("#ModalTitulo").text("Nuevo Expediente");
    LimpiarModal();
}

function AbrirModalEditar(ExpedienteID){
    
    $.ajax({
        // la URL para la petición
        url: '../../Expedientes/ListadoExpedientes',
        // la información a enviar
        // (también es posible utilizar una cadena de datos)
        data: { id: ExpedienteID},
        // especifica si será una petición POST o GET
        type: 'POST',
        // el tipo de información que se espera de respuesta
        dataType: 'json',
        // código a ejecutar si la petición es satisfactoria;
        // la respuesta es pasada como argumento a la función
       

            success: function (response) {
    let expediente = response.expedientes[0]; // ✅ Accedés al primer elemento del array "clientes"


            document.getElementById("ExpedienteID").value = expediente.expedienteID;
            $("#ModalTitulo").text("Editar Expediente");

            document.getElementById("ClienteID").value = expediente.clienteID;
            document.getElementById("EquipoID").value = expediente.equipoID;
            // document.getElementById("Numero").value = expediente.numero;
            document.getElementById("Caratula").value = expediente.caratula;
                        document.getElementById("FechaInicio").value = expediente.fechaInicio;
            @* document.getElementById("FechaFin").value = expediente.fechaFin; *@

            document.getElementById("UltimoDecreto").value = expediente.ultimoDecreto;
            document.getElementById("LinkContenido").value = expediente.linkContenido;

            @* document.getElementById("EstadoExpediente").value = expediente.estadoExpediente; *@
                        document.getElementById("Area").value = expediente.area;
            document.getElementById("Dependencia").value = expediente.dependencia;
            document.getElementById("Ubicacion").value = expediente.ubicacion;


            $("#ModalExpedientes").modal("show");

        },

        // código a ejecutar si la petición falla;
        // son pasados como argumentos a la función
        // el objeto de la petición en crudo y código de estatus de la petición
        error: function (xhr, status) {
            console.log('Disculpe, existió un problema al consultar el registro para ser modificado.');
        }
    });
}



function GuardarRegistro() {
    let expedienteID = document.getElementById("ExpedienteID").value;
    let clienteID = document.getElementById("ClienteID").value;
    let equipoID = document.getElementById("EquipoID").value;
    let caratula = document.getElementById("Caratula").value.trim();
    let ultimoDecreto = document.getElementById("UltimoDecreto").value.trim();
    let fechaInicio = document.getElementById("FechaInicio").value;
    let linkContenido = document.getElementById("LinkContenido").value.trim();
    let area = document.getElementById("Area").value;
    let dependencia = document.getElementById("Dependencia").value;
    let ubicacion = document.getElementById("Ubicacion").value;

    // Expresión regular para validar URL

    // 🟡 Validaciones
    if (clienteID === "0" || clienteID === "") {
        Swal.fire('Debe seleccionar un cliente.');
        return;
    }

    if (equipoID === "0" || equipoID === "") {
        Swal.fire('Debe seleccionar un equipo.');
        return;
    }

    if (caratula.length < 3) {
        Swal.fire('La carátula debe tener al menos 3 caracteres.');
        return;
    }

    if (ultimoDecreto.length < 3) {
        Swal.fire('El último decreto debe tener al menos 3 caracteres.');
        return;
    }

    if (!fechaInicio) {
        Swal.fire('Debe ingresar una fecha de inicio.');
        return;
    }

    let hoy = new Date();
    let fechaExpediente = new Date(fechaInicio);

    if (fechaExpediente > hoy) {
        Swal.fire("La fecha no puede ser futura.");
        return;
    }

    if (area === "0" || area === "") {
        Swal.fire("Debe seleccionar un área.");
        return;
    }

    if (dependencia === "0" || dependencia === "") {
        Swal.fire("Debe seleccionar una dependencia.");
        return;
    }

    if (ubicacion === "0" || ubicacion === "") {
        Swal.fire("Debe seleccionar una ubicación.");
        return;
    }

    // 🟢 Si pasa todas las validaciones, continuar con AJAX
    const data = {
        expedienteID: expedienteID,
        clienteID: clienteID,
        equipoID: equipoID,
        caratula: caratula,
        ultimoDecreto: ultimoDecreto,
        fechaInicio: fechaInicio,
        linkContenido: linkContenido,
        area: area,
        dependencia: dependencia,
        ubicacion: ubicacion,
    };

    const url = (expedienteID == 0 || expedienteID == "")
        ? '../../Expedientes/GuardarNuevoExpediente'
        : '../../Expedientes/EditarExpediente';

    $.ajax({
        url: url,
        type: 'POST',
        data: data,
        dataType: 'json',
        success: function (resultado) {
            if (resultado != "") {
                alert(resultado);
            }
            ListadoExpedientes(); // Refresca la lista de expedientes
            $("#ModalExpedientes").modal("hide"); // Cierra el modal
        },
        error: function (xhr, status) {
            console.log('Error al guardar o actualizar el expediente.');
        }
    });
}


