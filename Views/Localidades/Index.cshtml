@{
  ViewData["Title"] = "Localidades";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<body class="body2 fondoLogo">


  <div class="text-center m-4">
    <img src="~/img/localidadesImg.png" alt="" class="juntos imgIcono">
    <h1 class="titulos juntos">CARGAR LOCALIDADES</h1>
  </div>
  <hr class="hrTitulos m-4">


  <!-- Button trigger modal -->
  <div class="mb-2">
    <button type="button" class="btn btn-secondary" onclick="NuevoRegistro()" data-bs-toggle="modal"
      data-bs-target="#ModalLocalidades">
      Nueva Localidad
    </button>
  </div>
  @* //MODIFICAR AQUI IRIAN CARDS VER VER VER VER////////// *@

  <table class="table table-dark table-borderedless table-striped table-condensed">
    <thead>
      <tr>
        <th>Localidad</th>
        <th>Provincia</th>

        <th style="width: 70px"></th>
        <th style="width: 70px"></th>
      </tr>
    </thead>
    <tbody id="tbody-localidades">
    </tbody>
  </table>




  <!-- Modal -->
  <div class="modal fade" id="ModalLocalidades" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-secondary">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title" id="ModalTitulo">Nueva Localidad</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form>
            <div class="row">
              <input type="hidden" id="LocalidadID" value="0" />



              <div class="mb-3 col-6">
                <label for="LocalidadNombre" class="form-label">Ciudad</label>
                <input type="text" class="form-control" id="LocalidadNombre" style="text-transform:uppercase"
                  placeholder="Nombre">
              </div>




              <div class="mb-3 col-6">
                <label for="Provincia" class="form-label">Provincia</label>

                <select id="Provincia" name="Provincia" class="form-select form-control">
                  <option value="" disabled selected>SELECCIONAR</option>

                  @foreach (var provincia in Enum.GetValues(typeof(Provincia)))
                  {

                    <option value="@((int)provincia)">@provincia</option>
                  }
                </select>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" onclick="LimpiarModal()" class="btn btn-secondary"
            data-bs-dismiss="modal">Cancelar</button>
          <button type="button" onclick="GuardarRegistro()" class="btn btn-warning">Guardar</button>
        </div>
      </div>
    </div>
  </div>






  @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script src="~/js/localidad-1.0.0.js"></script>
  }

</body>