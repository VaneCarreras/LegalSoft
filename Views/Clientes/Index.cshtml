                  aria-controls="tab_1_1" aria-selected="true">Visualizar</a>
                <a class="nav-link" id="tab_1_2-tab" data-bs-toggle="tab" href="#tab_1_2" role="tab"
                  aria-controls="tab_1_2" aria-selected="false">Agregar</a>
                <a class="nav-link" id="tab_1_3-tab" data-bs-toggle="tab" href="#tab_1_3" role="tab"
