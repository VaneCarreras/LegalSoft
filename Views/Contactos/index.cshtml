@{
  ViewData["Title"] = "Contacto";
}

@* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@

<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">

<link rel="stylesheet" href="~/lib/animate.css">
<link href="~/css/leaflet-1.9.4.css" rel="stylesheet" />


@* <link rel="stylesheet" href="~/css/style.css"> *@

<body class="fondoLogo">



  <section id="Contacto">
    <div class="p-4">
      <div class="row ">
        <div class=" col-12 text-center">
          <img src="~/img/contactoImg.png" alt="" class="imgIcono juntos">
          <h1 class="titulos text-center juntos">CONTACTANOS</h1>
        </div>

        <hr class="hrTitulos m-4">

        <div class="col-md-6 col-12 text-center">

          <!-- Selección de Área -->
          <div class="form-group">
            <label for="areaSeleccionada" style="font-weight: bold;">SELECCIONA EL AREA POR LA QUE CONSULTA</label>
            <select id="areaSeleccionada" class="form-control" required>
              <option value="" selected disabled>Elegí un área</option>
              <option value="civil">Civil</option>
              <option value="penal">Penal</option>
              <option value="laboral">Laboral</option>
              <option value="comercial">Comercial</option>
              <option value="familiar">Familiar</option>
              <option value="otra">Otra</option>
            </select>
          </div>

          <!-- Formulario oculto al principio -->
          <form id="formContacto" class="mt-3" style="display: none;">
            <div id="spinner" class="text-center my-3" style="display: none;">
              <div class="spinner-border text-primary" role="status">
                <span class="sr-only">ENVIANDO</span>
              </div>
            </div>

            <div id="alerta" class="mt-3"></div>

            <div class="form-group">
              <label for="Nombre">Nombre</label>
              <input id="Nombre" name="Nombre" class="form-control" required />
            </div>

            <div class="form-group">
              <label for="Email">Email</label>
              <input id="Email" name="Email" type="email" class="form-control" required />
            </div>

            <!-- Aquí van los campos dinámicos -->
            <div id="camposArea"></div>



            <button type="submit" class="btn btn-primary mt-4">Enviar</button>
          </form>

        </div>


        <div class="col-md-6 col-12 text-center cerrar">

          <div id="leaflet-map" class="info-box" style="height: 320px; border: 3px solid #fff;"></div>
          <br>
          <div>
            <a class="icono" href="https://www.facebook.com/vanecarreras91/" target="_blank"><i
                class="fa-brands fa-facebook-f"></i></a>
            <a class="icono" href="https://z-p15.www.instagram.com/carreras.vanessa/?hl=es-la" target="_blank"><i
                class="fa-brands fa-instagram"></i></a>

            <a class="icono" href="https://wa.me/3562671294" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
            <a class="icono" href="https://www.linkedin.com/in/vanessa-carreras/" target="_blank"><i
                class="fa-brands fa-linkedin-in"></i></a>

            <div><i class="fa-solid fa-location-dot icono2"></i>
              <p class="bco">Sarmiento 97, Morteros, Córdoba, Argentina</p>
            </div>
            <div><i class="fa-solid fa-phone icono2"></i>
              <p class="bco">3562-671294</p>
            </div>





          </div>
        </div>
      </div>
    </div>
  </section>





  @*     

  <script src="~/lib/jquery-3.5.1.slim.min.js"></script>

  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@

  @section Scripts{

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script src="~/lib/fontawesome/js/all.min.js"></script>

    <script src="~/lib/wow.js"></script>
    <script src="~/js/leaflet-1.9.4.js"></script>
    <script>
      //**************************************************
      //ARMAMOS EL MAPA DE LEAFLET MAP CON LAS UBICACIONES
      //**************************************************
      document.addEventListener('DOMContentLoaded', function () {
        // Array con las ubicaciones y la información de la marca
        var locations = [
          {
            coordinates: [-30.717785, -62.001500],
            popupText: '(Estudio CC)'
          }
          // Agrega más ubicaciones si es necesario
        ];

        // Crea el mapa
        var map = L.map('leaflet-map').setView([-32.7, -62.0], 14);
        // var map = L.map('leaflet-map').setView(locations[0].coordinates, 13);

        // Agrega un proveedor de mapas (puedes cambiar a otros proveedores)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Itera sobre las ubicaciones y agrega las marcas al mapa con el ícono de Bootstrap
        locations.forEach(function (location) {
          L.marker(location.coordinates, { icon: L.divIcon({ className: 'bi bi-geo-alt-fill' }) }).addTo(map)
            .bindPopup(location.popupText)
            .openPopup();
        });
      });

    </script>
    <script>
      new WOW().init();
    </script>

    <script>
      $("#formContacto").on("submit", function (e) {
        e.preventDefault();
$("#spinner").show();  
  $("#alerta").hide();
        let datos = {
          Nombre: $("input[name='Nombre']").val(),
          Email: $("input[name='Email']").val(),
          AreaSeleccionada: $("#areaSeleccionada").val()
        };

        const camposDinamicos = ["Empleador", "Horas", "Situacion", "Sueldo", "Vinculo", "Datos", "Datos2", "Motivo", "Delito", "Tipo", "Detalle"];

        camposDinamicos.forEach(campo => {
          const elemento = $(`[name='${campo}']`);
          if (elemento.length && elemento.val()) {
            datos[campo] = elemento.val();
          }
        });

        $.ajax({
          url: '@Url.Action("EnviarCorreo", "Contactos")',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify(datos),
          success: function (res) {
                                $("#spinner").hide();  

            if (res.exito) {

              $("#alerta").html(`<div class="alert alert-success">${res.mensaje}</div>`).show();
              $("#formContacto")[0].reset();
              setTimeout(() => {
                $("#alerta").fadeOut(400);
              }, 700);
            } else if (res.errores) {
              let mensajes = Object.values(res.errores).flat().join("<br>");
              $("#alerta").html(`<div class="alert alert-danger">${mensajes}</div>`).show();
            } else {
              $("#alerta").html(`<div class="alert alert-danger">${res.mensaje}</div>`).show();
            }
          },
          error: function () {
                  $("#spinner").hide();  

            $("#alerta").html(`<div class="alert alert-danger">Error inesperado al enviar el mensaje.</div>`).show();
          }
        });

      });

    </script>


    <script>
      document.getElementById('areaSeleccionada').addEventListener('change', function () {
        const area = this.value;
        const form = document.getElementById('formContacto');
        const camposArea = document.getElementById('camposArea');

        // Mostrar el formulario
        form.style.display = 'block';
        camposArea.innerHTML = ''; // Limpiar campos anteriores

        if (area === 'laboral') {
          camposArea.innerHTML = `
            <div class="row">
            <div class="form-group col-md-6">
              <label for="Empleador">Empleador</label>
              <input id= "Empleador" name="Empleador" class="form-control" required />
            </div>
            <div class="form-group col-md-6">
              <label for="Horas">Horas semanales</label>
              <input id= "Horas" name="Horas" class="form-control" required />
            </div>        
            <div class="form-group col-md-6">
              <label for="Situacion">Situación (Recibo, Contrato, Negro)</label>
              <input id= "Situacion" name="Situacion" class="form-control" required />
            </div>        
            <div class="form-group col-md-6">
              <label for="Sueldo">Sueldo</label>
              <input id= "Sueldo" name="Sueldo" class="form-control" />
            </div>
            <div class="form-group col-md-12">
              <label for="Detalle">Detalle del caso</label>
              <textarea id= "Detalle" name="Detalle" class="form-control" rows="1" required></textarea>
            </div>
            </div>`;
        } else if (area === 'familiar') {
          camposArea.innerHTML = `
                  <div class="row">

            <div class="form-group col-md-12">
              <label for="Vinculo">Vínculo Familiar</label>
              <input id= "Vinculo" name="Vinculo" class="form-control" required />
            </div>
            <div class="form-group col-md-6">
              <label for="Datos">Detalle de datos personales</label>
              <textarea id= "Datos" name="Datos" class="form-control" rows="1" required></textarea>
            </div>
            <div class="form-group col-md-6">
              <label for="Datos2">Datos del hijo, expareja, etc</label>
              <textarea id= "Datos2" name="Datos2" class="form-control" rows="1" required></textarea>
            </div>
            <div class="form-group col-md-12">
              <label for="Detalle">Detalle del caso</label>
              <textarea id= "Detalle" name="Detalle" class="form-control" rows="1" required></textarea>
            </div>
                    </div>`;
        } else if (area === 'civil' || area === 'comercial' || area === 'otra') {
          camposArea.innerHTML = `
            <div class="form-group">
              <label for="Motivo">Motivo que amerita la intervención legal</label>
              <input id= "Motivo" name="Motivo" class="form-control" required />
            </div>
            <div class="form-group">
              <label for="Detalle">Detalle del caso</label>
              <textarea id= "Detalle" name="Detalle" class="form-control" rows="1" required></textarea>
            </div>`;
        } else if (area === 'penal') {
          camposArea.innerHTML = `
            <div class="form-group">
              <label for="Delito">Tipo de delito</label>
              <input id= "Delito" name="Delito" class="form-control" required />
            </div>
            <div class="form-group">
              <label for="Tipo">Tipo de intervención (denunciante/ denunciado)</label>
              <input id= "Tipo" name="Tipo" class="form-control" required />
            </div>
            <div class="form-group">
              <label for="Detalle">Detalle del caso</label>
              <textarea id= "Detalle" name="Detalle" class="form-control" rows="1" required></textarea>
            </div>`;
        }
        else {
          form.style.display = 'none';
        }

      });
    </script>


  }


</body>
