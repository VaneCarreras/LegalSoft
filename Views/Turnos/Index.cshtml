<html>

<head>
  <meta charset='utf-8' />
  @section Scripts {

    <script src="~/lib/fullcalendar-6.1.15/dist/index.global.js"></script>
    <script src="~/lib/fullcalendar-6.1.15/packages/core/locales/es.global.js"></script>

  }


</head>






<body class="body2 fondoLogo">
  <div class="row">
    <div class="text-center m-4 col-2">

      <img src="~/img/calendario.png" alt="" class="juntos1 imgIconoTurno text-center">
      <h1 class="titulos1">MIS TURNOS</h1>
      


      <hr class="">
    </div>
    <div class="chico col-10" id="calendar">
<h6 class="text-center">Verde: Vacante --- Rojo: Asistido --- Amarillo: Suspendido</p>

    </div>
  </div>
  <!-- Modal Turnos -->
  <div class="modal fade" id="ModalTurnos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-secondary">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title">Turno</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form>
            <input type="hidden" id="TurnoID" value="0" />
            <div class="row">
              <div class="mb-3 col-6">
                <label for="ClienteID" class="form-label">Cliente</label>
                <select class="form-control form-select" id="ClienteID">
                </select>
              </div>

              <div class="mb-3 col-6">
                <label for="EquipoID" class="form-label">Equipo</label>
                <select class="form-control form-select" id="EquipoID">
                </select>
              </div>

              <div class="mb-3 col-6">
                <label class="form-label">Fecha y Hora</label>
                <input type="datetime-local" class="form-control" id="FechaHora" />
              </div>
              <div class="mb-3 col-6">
                <label class="form-label">Estado</label>
                <select id="Estado" class="form-control form-select">
        <option value="" disabled selected>SELECCIONAR</option>

                  <option value="0">Vacante</option>
                  <option value="1">Asistido</option>
                  <option value="2">Suspendido</option>
                </select>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
            onclick="LimpiarModal()">Cancelar</button>
          <button type="button" class="btn btn-warning" onclick="GuardarTurno()">Guardar</button>
          <button type="button" class="btn btn-success" onclick="ImprimirTicket()">Imprimir Ticket</button>
        </div>
      </div>
    </div>
  </div>

  <script>


    var calendar;

    document.addEventListener('DOMContentLoaded', function () {
      var calendarEl = document.getElementById('calendar');

      calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'es',
        selectable: true,
        dateClick: function (info) {
          $('#TurnoID').val('0'); // Asegura que sea un nuevo turno
          $('#FechaHora').val(info.dateStr + 'T09:00'); // horario por defecto
          $('#ModalTurnos').modal('show');
        },




        // Personalizar contenido de los eventos
        eventContent: function (arg) {
          const estado = arg.event.extendedProps.estado;
          let color = '#007bff'; // Azul por defecto

          if (estado === 0) {
            color = 'green'; // vacante
          } else if (estado === 1) {
            color = 'red'; // asistido
          }
          else if (estado === 2) {
            color = 'yellow'; // suspendido
          }

          const dotEl = document.createElement('span');
          dotEl.style.backgroundColor = color;
          dotEl.style.borderRadius = '50%';
          dotEl.style.display = 'inline-block';
          dotEl.style.width = '10px';
          dotEl.style.height = '10px';
          dotEl.style.marginRight = '6px';
          dotEl.style.verticalAlign = 'middle';

          const textEl = document.createElement('span');
          textEl.innerText = arg.event.title;

          return { domNodes: [dotEl, textEl] };
        },





        eventClick: function (info) {
          const evento = info.event;
          $('#TurnoID').val(evento.extendedProps.turnoID);
          $('#ClienteID').val(evento.extendedProps.clienteID);
          $('#EquipoID').val(evento.extendedProps.equipoID);
          $('#FechaHora').val(evento.startStr.substring(0, 16));
          $('#Estado').val(evento.extendedProps.estado);
          $('#ModalTurnos').modal('show');
        },
        events: '/Turnos/GetEvents'
      });

      calendar.render();


      cargarClientes();
      cargarEquipos();


      function cargarClientes() {
        fetch('/Turnos/GetClientes')
          .then(response => response.json())
          .then(data => {
            const clienteSelect = document.getElementById('ClienteID');
            console.log('Clientes recibidos:', data); // 👈 agrega esto

      clienteSelect.innerHTML = '<option value="" disabled selected>SELECCIONAR</option>';
            data.forEach(cliente => {
              const option = document.createElement('option');
              option.value = cliente.clienteID;
              option.text = cliente.nombreCompleto;
              clienteSelect.appendChild(option);
            });
          })
          .catch(error => console.error('Error al cargar clientes:', error));
      }

      function cargarEquipos() {
        fetch('/Turnos/GetEquipos')
          .then(response => response.json())
          .then(data => {
            const equipoSelect = document.getElementById('EquipoID');
      equipoSelect.innerHTML = '<option value="" disabled selected>SELECCIONAR</option>';
            data.forEach(equipo => {
              const option = document.createElement('option');
              option.value = equipo.equipoID;
              option.text = equipo.nombreCompleto; // 
              equipoSelect.appendChild(option);
            });
          })
          .catch(error => console.error('Error al cargar equipos:', error));
      }

    });

    function GuardarTurno() {
      const turno = {
        TurnoID: $('#TurnoID').val(),
        ClienteID: $('#ClienteID').val(),
        EquipoID: $('#EquipoID').val(),
        FechaHora: $('#FechaHora').val(),
        Estado: $('#Estado').val()
      };

      // Validaciones
  if (!turno.ClienteID || turno.ClienteID === "0") {
    Swal.fire('Falta el Cliente');
    return;
  }

  if (!turno.EquipoID || turno.EquipoID === "0") {
    Swal.fire('Falta el Equipo');
    return;
  }

  if (!turno.FechaHora) {
    Swal.fire('Falta la Fecha');
    return;
  }

  

  if (!turno.Estado) {
    Swal.fire('Falta el Estado');
    return;
  }


      $.ajax({
        url: '/Turnos/SaveEvent',
        method: 'POST',
        data: turno,
        success: function (res) {
          if (res.success) {
            calendar.refetchEvents();
            $('#ModalTurnos').modal('hide');
            LimpiarModal();
            Swal.fire('¡Turno guardado!', '', 'success');
          } else {
            Swal.fire('Error', 'No se pudo guardar el turno.', 'error');
          }
        }
      });
    }

    function LimpiarModal() {
      $('#TurnoID').val('0');
      $('#ClienteID').val('');
      $('#EquipoID').val('');
      $('#FechaHora').val('');
      $('#Estado').val('0');
    }

    function ImprimirTicket() {
      const turnoID = $('#TurnoID').val();
      if (turnoID === '0') {
        Swal.fire('Primero guarda el turno', '', 'warning');
        return;
      }
      window.location.href = '/Turnos/ImprimirTicket?turnoID=' + turnoID;
    }
  </script>

</body>
